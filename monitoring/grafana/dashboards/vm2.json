                },
                "0": {
                  "text": "HTTP THẤT BẠI",
                  "color": "red"
                },
                "1": {
                  "text": "HTTP ĐẠT",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(probe_success{job=\"http-vm2\"} and on(job, instance) (up{job=\"http-vm2\"} == 1)) or on() vector(-1)",
          "legendFormat": "HTTP VM2",
          "instant": false,
          "range": true
        }
      ]
    }
  ]
