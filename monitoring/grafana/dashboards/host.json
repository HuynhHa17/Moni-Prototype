      "description": "Từ counter node_network_*_bytes_total, rate rồi nhân 8 ra bit/s. Gửi vẽ phía âm. Bỏ loopback và interface ảo của Docker/bridge (lo, veth*, docker*, br-*, virbr*) vì không phải lưu lượng ra/vào host.",
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "noValue": "CHƯA XÁC ĐỊNH",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*gửi$"
            },
            "properties": [
              {
                "id": "custom.transform",
                "value": "negative-Y"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(8 * rate(node_network_receive_bytes_total{job=\"node\",host=\"$host\",device!~\"lo|veth.*|docker.*|br-.*|virbr.*\"}[$__rate_interval])) and on(instance) (up{job=\"node\",host=\"$host\"} == 1)",
          "legendFormat": "{{device}} nhận",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "(8 * rate(node_network_transmit_bytes_total{job=\"node\",host=\"$host\",device!~\"lo|veth.*|docker.*|br-.*|virbr.*\"}[$__rate_interval])) and on(instance) (up{job=\"node\",host=\"$host\"} == 1)",
          "legendFormat": "{{device}} gửi",
          "instant": false,
          "range": true
        }
      ]
