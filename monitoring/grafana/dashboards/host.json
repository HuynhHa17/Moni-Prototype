{
  "uid": "moni-vm2",
  "title": "Host — tài nguyên và HTTP",
  "description": "Chọn host. Hàng trên cùng trả lời: dịch vụ có chạy không, tài nguyên có gần ngưỡng không, đang có cảnh báo nào. Thiếu dữ liệu hiện CHƯA XÁC ĐỊNH, không bị coi là lỗi. UID giữ để tương thích URL cũ.",
  "tags": [
    "moni",
    "host"
  ],
  "schemaVersion": 39,
  "version": 6,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Tổng quan",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "HTTP /health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "CHƯA XÁC ĐỊNH",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "CHƯA XÁC ĐỊNH",
                  "color": "gray"
                },
                "0": {
                  "text": "LỖI",
                  "color": "red"
                },
                "1": {
                  "text": "ĐẠT",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(probe_success{job=\"http\",host=\"$host\"} and on(job, instance) (up{job=\"http\",host=\"$host\"} == 1)) or on() vector(-1)",
          "legendFormat": "{{host}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "Kết quả probe Blackbox tới /health. CHƯA XÁC ĐỊNH khi Prometheus không scrape được Blackbox, để không nhầm mất dữ liệu với dịch vụ lỗi."
    },
    {
      "id": 14,
      "title": "Độ trễ HTTP",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Thời gian một lần probe /health thành công. Màu chỉ để đọc nhanh, không phải ngưỡng cảnh báo.",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "CHƯA XÁC ĐỊNH",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"http\",host=\"$host\"} and on(job, instance) (up{job=\"http\",host=\"$host\"} == 1) and on(job, instance) (probe_success{job=\"http\",host=\"$host\"} == 1)",
          "legendFormat": "{{host}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 15,
      "title": "CPU",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Cùng công thức và cửa sổ 2m với rule HostHighCpu. Đỏ từ 85% = ngưỡng của rule (rule còn chờ thêm 3 phút).",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "CHƯA XÁC ĐỊNH",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * (1 - avg by(host) (rate(node_cpu_seconds_total{job=\"node\",host=\"$host\",mode=\"idle\"}[2m])))) and on(host) (up{job=\"node\",host=\"$host\"} == 1)",
          "legendFormat": "{{host}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 16,
      "title": "RAM",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "RAM đã dùng theo MemAvailable. Chưa có rule RAM; màu chỉ để đọc nhanh.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "CHƯA XÁC ĐỊNH",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * (1 - node_memory_MemAvailable_bytes{job=\"node\",host=\"$host\"} / node_memory_MemTotal_bytes{job=\"node\",host=\"$host\"})) and on(instance) (up{job=\"node\",host=\"$host\"} == 1)",
          "legendFormat": "{{host}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 17,
      "title": "Disk đầy nhất",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Filesystem có % đã dùng cao nhất. Đỏ từ 90% = ngưỡng rule FilesystemAlmostFull. Xem từng mountpoint ở panel bên dưới.",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "CHƯA XÁC ĐỊNH",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(host) (100 * (1 - node_filesystem_avail_bytes{job=\"node\",host=\"$host\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs\"} / (node_filesystem_size_bytes{job=\"node\",host=\"$host\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs\"} > 0))) and on(host) (up{job=\"node\",host=\"$host\"} == 1)",
          "legendFormat": "{{host}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "title": "Uptime",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "description": "time() - node_boot_time_seconds: thời gian từ lần khởi động gần nhất của host. Không dùng up, vì up chỉ cho biết lần scrape gần nhất thành công.",
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "noValue": "CHƯA XÁC ĐỊNH",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - node_boot_time_seconds{job=\"node\",host=\"$host\"}) and on(instance) (up{job=\"node\",host=\"$host\"} == 1)",
          "legendFormat": "{{host}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 18,
      "title": "Cảnh báo đang bật",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 6
      },
      "description": "Series ALERTS của Prometheus cho host này. pending = điều kiện đúng nhưng chưa đủ thời gian chờ; firing = đã gửi Alertmanager.",
      "fieldConfig": {
        "defaults": {
          "noValue": "Không có cảnh báo"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Trạng thái"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "text": "firing",
                        "color": "red"
                      },
                      "pending": {
                        "text": "pending",
                        "color": "orange"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "environment": true,
              "host": true
            },
            "indexByName": {
              "alertname": 0,
              "alertstate": 1,
              "severity": 2
            },
            "renameByName": {
              "alertname": "Cảnh báo",
              "alertstate": "Trạng thái",
              "severity": "Mức"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{host=\"$host\"}",
          "format": "table",
          "instant": true,
          "range": false
        }
      ]
    },
