# Copy to .env at the repository root on each Linux VM. Never commit .env.
# Use the same workload addresses on VM1 and VM2, then render targets on VM1.
WORKLOAD_IP=CHANGE_ME
WORKLOAD_HOST=workload-vm2
WORKLOAD_HTTP_PORT=8080
WORKLOAD_CADVISOR_PORT=8081
ENVIRONMENT=lab
DEFAULT_SITE=onprem-lab
DEFAULT_RACK=rack-01
DEFAULT_TEAM=infra

# Optional second workload: planned for multi-host integration lab.
# Leave its IP empty for an individual two-VM lab. No VM3 is created by render.
WORKLOAD_VM3_IP=
WORKLOAD_VM3_HOST=workload-vm3
WORKLOAD_VM3_HTTP_PORT=8080
WORKLOAD_VM3_CADVISOR_PORT=8081

# VM1 published ports. SEC-01 must verify firewall, network and TLS rules.
MONITORING_BIND_IP=0.0.0.0
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Alertmanager chỉ publish trên 127.0.0.1 của VM1, máy khác không truy cập được.
ALERTMANAGER_PORT=9093

# Grafana admin credentials (required in production/lab, never commit real values).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA

# PostgreSQL 16 for alert history (ADR-04.2 — internal to VM1 Docker network only).
POSTGRES_DB=moni_history
POSTGRES_USER=moni
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
