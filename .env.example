# Copy to .env at the repository root on each Linux VM. Never commit .env.
# Use the same workload addresses on VM1 and VM2, then render targets on VM1.
WORKLOAD_IP=CHANGE_ME
WORKLOAD_HOST=workload-vm2
WORKLOAD_HTTP_PORT=8080
ENVIRONMENT=lab

# Optional second workload: planned for the M3 integration lab only.
# Leave its IP empty for an individual two-VM lab. No VM3 is created by render.
WORKLOAD_VM3_IP=
WORKLOAD_VM3_HOST=workload-vm3
WORKLOAD_VM3_HTTP_PORT=8080

# VM1 published ports. These preserve the current lab behavior.
# SEC-01 must verify the actual firewall, network and access permissions.
MONITORING_BIND_IP=0.0.0.0
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# No WEBHOOK_PORT: the planned receiver is internal to the VM1 Docker network.
# CPU/disk thresholds and for durations are provisional until BSL-01.
# They will be added with the rules; no unused threshold variables are exposed.
# Alertmanager chỉ publish trên 127.0.0.1 của VM1, máy khác không truy cập được.
ALERTMANAGER_PORT=9093
