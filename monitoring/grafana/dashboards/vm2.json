{
  "uid": "moni-vm2",
  "title": "VM2 — Host và HTTP",
  "description": "Giám sát tài nguyên VM2 và phép kiểm tra HTTP /health từ VM1. Giá trị -1 biểu thị chưa xác định khi thiếu dữ liệu kiểm tra.",
  "tags": [
    "moni",
    "vm2"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP VM2 — kết quả kiểm tra /health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "CHƯA XÁC ĐỊNH",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "CHƯA XÁC ĐỊNH",
                  "color": "gray"
                },
                "0": {
                  "text": "HTTP THẤT BẠI",
                  "color": "red"
                },
                "1": {
                  "text": "HTTP ĐẠT",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(probe_success{job=\"http-vm2\"} and on(job, instance) (up{job=\"http-vm2\"} == 1)) or on() vector(-1)",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "title": "Thu thập tài nguyên VM2",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "CHƯA XÁC ĐỊNH",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "CHƯA XÁC ĐỊNH",
                  "color": "gray"
                },
                "0": {
                  "text": "MẤT THU THẬP",
                  "color": "red"
                },
                "1": {
                  "text": "THU THẬP ĐƯỢC",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"node-vm2\"} or on() vector(-1)",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Thu thập kết quả Blackbox",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "CHƯA XÁC ĐỊNH",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "CHƯA XÁC ĐỊNH",
                  "color": "gray"
                },
                "0": {
                  "text": "MẤT THU THẬP",
                  "color": "red"
                },
                "1": {
                  "text": "THU THẬP ĐƯỢC",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"http-vm2\"} or on() vector(-1)",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "title": "CPU sử dụng (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "CHƯA XÁC ĐỊNH",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{job=\"node-vm2\",mode=\"idle\"}[5m])))) and on(instance) (up{job=\"node-vm2\"} == 1)",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "RAM sử dụng (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "CHƯA XÁC ĐỊNH",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * (1 - node_memory_MemAvailable_bytes{job=\"node-vm2\"} / node_memory_MemTotal_bytes{job=\"node-vm2\"})) and on(instance) (up{job=\"node-vm2\"} == 1)",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Dung lượng filesystem đã dùng (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "CHƯA XÁC ĐỊNH",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * (1 - node_filesystem_avail_bytes{job=\"node-vm2\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs\"} / (node_filesystem_size_bytes{job=\"node-vm2\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs\"} > 0))) and on(instance) (up{job=\"node-vm2\"} == 1)",
          "legendFormat": "{{instance}} — {{mountpoint}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Thời gian probe HTTP thành công",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "CHƯA XÁC ĐỊNH",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"http-vm2\"} and on(job, instance) (up{job=\"http-vm2\"} == 1) and on(job, instance) (probe_success{job=\"http-vm2\"} == 1)",
          "legendFormat": "HTTP VM2",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Diễn biến trạng thái HTTP",
